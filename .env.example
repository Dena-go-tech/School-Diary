# Скопируйте в .env и при необходимости измените
POSTGRES_USER=diary
POSTGRES_PASSWORD=diary
POSTGRES_DB=diary
APP_PORT=8080
DB_PORT=5432

# Для npm run dev (локально, вне Docker)
DATABASE_URL=postgres://diary:diary@localhost:5432/diary

# Cloudflare Tunnel: токен из Zero Trust → Networks → Tunnels → (туннель) → Install connector
CLOUDFLARE_TUNNEL_TOKEN=
